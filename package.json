{
  "name": "dsh-cognitive-feedback",
  "version": "0.1.0",
  "description": "Lightweight cognitive-feedback plugin for DeepSeek Harness: protects human reasoning ownership at high-value decision points without breaking normal coding flow or prompt-cache reuse.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "clean": "rm -rf dist",
    "test": "npm run build && node --test test/*.test.js",
    "test:unit": "node --test test/*.test.js",
    "test:live": "npm run build && bash test/live/run-live.sh",
    "resolve:dsh-types": "node scripts/resolve-dsh-types.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.2"
  }
}
